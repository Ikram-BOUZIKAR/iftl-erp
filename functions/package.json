{
  "name": "educloud-erp-functions",
  "description": "Firebase Cloud Functions for EduCloud ERP — SMS/WhatsApp alerts via Twilio",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
