rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Fonctions utilitaires ──────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isStaff() {
      return request.auth.token.role in ['admin', 'direction', 'scolarite', 'intervenant'];
    }
    function isAdmin() {
      return request.auth.token.role in ['admin', 'direction'];
    }

    // ── Documents pédagogiques (syllabus, fiches de séance) ────────────────
    // Écriture : intervenants + staff uniquement
    // Lecture  : tout utilisateur authentifié
    match /sessions/{folder}/{fileName} {
      allow read:   if isAuth();
      allow create: if isStaff() && request.resource.size < 20 * 1024 * 1024
                       && request.resource.contentType.matches('application/(pdf|msword|vnd\\.openxmlformats.*|vnd\\.ms-powerpoint)|image/.*');
      allow update: if isStaff() && request.resource.size < 20 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ── Documents apprenants (attestations, conventions…) ─────────────────
    match /apprenants/{studentId}/{fileName} {
      allow read:   if isAuth();
      allow create, update: if isAdmin() && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ── Ressources pédagogiques générales ──────────────────────────────────
    match /ressources/{fileName} {
      allow read:   if isAuth();
      allow create, update: if isStaff() && request.resource.size < 50 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ── Par défaut : refuser tout accès non couvert ────────────────────────
    match /{allPaths=**} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }
  }
}
