VITE_FIREBASE_API_KEY=YOUR_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=YOUR_AUTH_DOMAIN_HERE
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID_HERE
VITE_FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET_HERE
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID_HERE
VITE_FIREBASE_APP_ID=YOUR_APP_ID_HERE

# ─── SMS / WhatsApp (Twilio via Firebase Cloud Functions) ──────────────────────
# Credentials are stored server-side in Firebase Functions config — NEVER in VITE_ vars.
# Deploy with:
#   firebase functions:config:set \
#     twilio.account_sid="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" \
#     twilio.auth_token="your_auth_token" \
#     twilio.phone_from="+212600000000"
# For WhatsApp sandbox: twilio.phone_from="+14155238886"
# Then: firebase deploy --only functions
